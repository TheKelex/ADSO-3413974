    <bpmn:sequenceFlow id="F8" sourceRef="T4" targetRef="G2" />
    <bpmn:sequenceFlow id="F9" name="Sí" sourceRef="G2" targetRef="T5" />
    <bpmn:sequenceFlow id="F10" name="No" sourceRef="G2" targetRef="EE" />
    <bpmn:sequenceFlow id="F11" sourceRef="T5" targetRef="S2" />
    <bpmn:sequenceFlow id="F12" sourceRef="S2" targetRef="EE" />
