  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_1" name="Gestion de Horarios" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_A" name="Aprendiz">
        <bpmn:flowNodeRef>SE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SE" name="Credenciales válidas">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Revisar apartado Mi Horario">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="¿Ver detalle de una clase?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T3" name="Revisar notificaciones">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="¿Hay notificación sin leer?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T4" name="Leer detalle">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EE" name="Información consultada">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="SE" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="F3" name="Sí" sourceRef="G1" targetRef="T2" />
    <bpmn:sequenceFlow id="F4" name="No" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="F5" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F6" sourceRef="T3" targetRef="G2" />
    <bpmn:sequenceFlow id="F7" name="Sí" sourceRef="G2" targetRef="T4" />
    <bpmn:sequenceFlow id="F8" name="No" sourceRef="G2" targetRef="EE" />
    <bpmn:sequenceFlow id="F9" sourceRef="T4" targetRef="EE" />
    <bpmn:task id="T2" name="Consultar detalle">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
